<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/buffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/vurgu"
        app:indicatorSize="48dp"
        app:trackThickness="4dp" />

    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_error"
            app:tint="@color/hata" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/metin"
            android:textSize="15sp"
            tools:text="Yayın açılamadı." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/tekrar_dene" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F0141B23"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingTop="64dp"
        android:paddingBottom="80dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/kanallar"
                android:textColor="@color/metin"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/channelCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textColor="@color/soluk"
                android:textSize="11sp"
                tools:text="12 kanal" />

            <ImageButton
                android:id="@+id/panelCloseButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/kanal_listesini_kapat"
                android:src="@drawable/ic_close"
                app:tint="@color/soluk" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@color/kanal_cizgi" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#A6000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/geri"
            android:src="@drawable/ic_back"
            app:tint="@color/beyaz" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/channelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/beyaz"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Kanal adı" />

            <TextView
                android:id="@+id/channelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/soluk"
                android:textSize="12sp"
                tools:text="Canlı yayın" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/listButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kanal_listesini_gizle"
            android:src="@drawable/ic_list"
            android:visibility="gone"
            app:tint="@color/beyaz" />

        <ImageButton
            android:id="@+id/castButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dlna_gonder"
            android:src="@drawable/ic_cast"
            app:tint="@color/beyaz" />

        <ImageButton
            android:id="@+id/mirrorButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/yansitma_gonder"
            android:src="@drawable/ic_tv"
            app:tint="@color/beyaz" />

        <ImageButton
            android:id="@+id/sizeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ekran_boyutu"
            android:src="@drawable/ic_aspect_ratio"
            app:tint="@color/beyaz" />

        <ImageButton
            android:id="@+id/externalButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/harici_oynatici"
            android:src="@drawable/ic_external"
            app:tint="@color/beyaz" />

        <ImageButton
            android:id="@+id/rotateButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ekrani_dondur"
            android:src="@drawable/ic_rotate"
            app:tint="@color/beyaz" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#A6000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rewindButton"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/geri_sar"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/geri_sar_15_kisa"
                android:textColor="@color/beyaz"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/oynat"
                android:src="@drawable/ic_play"
                app:tint="@color/beyaz" />

            <TextView
                android:id="@+id/forwardButton"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/ileri_sar"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/ileri_sar_15_kisa"
                android:textColor="@color/beyaz"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Zaman çizgisi yalnızca ileri/geri sarılabilen yayınlarda görünür. -->
        <LinearLayout
            android:id="@+id/seekGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical"
            android:visibility="gone">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/zaman_cizgisi"
                android:max="100"
                android:progressBackgroundTint="@color/cizgi"
                android:progressTint="@color/vurgu"
                android:thumbTint="@color/vurgu" />

            <TextView
                android:id="@+id/seekTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/soluk"
                android:textSize="13sp"
                tools:text="01:23 / 45:00" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kaydırma hareketiyle yapılan parlaklık/ses ayarının görsel geri bildirimi. -->
    <LinearLayout
        android:id="@+id/gestureIndicator"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_gesture_indicator"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gestureIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_brightness"
            app:tint="@color/vurgu" />

        <TextView
            android:id="@+id/gestureLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/metin"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Parlaklık" />

        <TextView
            android:id="@+id/gestureValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/soluk"
            android:textSize="12sp"
            tools:text="%60" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/gestureProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:indicatorColor="@color/vurgu"
            app:trackColor="@color/cizgi"
            app:trackThickness="5dp" />
    </LinearLayout>

</FrameLayout>
